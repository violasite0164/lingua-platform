# ─── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# 結帳成功後導回用（須 HTTPS 正式網域，Apple Pay 才會在嵌入式 Checkout 顯示）
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# 可選：Dashboard → Payment method configurations 的 ID（需已啟用 Apple Pay）
# STRIPE_PAYMENT_METHOD_CONFIGURATION=pmc_...

# Stripe Price IDs (create in Stripe Dashboard)
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# ─── Azure Speech（課堂測驗題目／選項英文 TTS）────────────────────────────────
# Azure Portal → Speech resource → Keys and Endpoint
AZURE_SPEECH_KEY=your-speech-key
# 區域「代碼」（非顯示名稱）：eastasia、eastus、westeurope 等
AZURE_SPEECH_REGION=eastasia
# 可選，預設 en-US-JennyNeural；英式例：en-GB-SoniaNeural
# AZURE_SPEECH_VOICE=en-US-JennyNeural

# ─── Cloudflare Stream ───────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_STREAM_API_TOKEN=your-api-token
NEXT_PUBLIC_CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=customer-xxx.cloudflarestream.com

# ─── Rive（Super Fun Quiz 動畫）──────────────────────────────────────────────
# NEXT_PUBLIC_RIVE_QUIZ_ENABLED=false
# NEXT_PUBLIC_RIVE_QUIZ_PROP_URL=https://cdn.example.com/quiz-prop.riv
# NEXT_PUBLIC_RIVE_QUIZ_BOY_URL=https://cdn.example.com/quiz-mascot-boy.riv
# NEXT_PUBLIC_RIVE_QUIZ_GIRL_URL=https://cdn.example.com/quiz-mascot-girl.riv

# 可選：定時清理逾時 pending 訂單（GET /api/cron/expire-pending-purchases，Bearer 此 secret）
# CRON_SECRET=your-random-secret

# ─── App ─────────────────────────────────────────────────────────────────────
# OAuth redirect must match this URL (also add /auth/callback in Supabase → Authentication → URL).
# Production: https://your-domain.com   Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# YouTube 首頁背景：預設使用 youtube.com。設為 true 則改用 youtube-nocookie（較嚴格隱私，但有環境會出現「Sign in to confirm you are not a bot」）。
# NEXT_PUBLIC_YOUTUBE_EMBED_USE_NOCOOKIE=true
